<!DOCTYPE html>
<html lang="en">

<head>
    {% include "head" %}
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="canvas-grid" aria-hidden="true"></div>
    <div class="canvas-scanlines" aria-hidden="true"></div>
    <div class="canvas-vignette" aria-hidden="true"></div>

    {% include "navbar" %}

    <main class="page-main" id="main-content" tabindex="-1">
        <div class="shell">
            {{ content }}
        </div>
    </main>

    {% include "footer" %}

    <button class="back-to-top" type="button" id="back-to-top" aria-label="Back to top">
        <i class="fas fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script src="/scripts/site.js" defer></script>
</body>
</html>
