<section class="hero" id="about">
    <div class="hero__grid">
        <div class="hero__main">
            {% if profile.status and profile.status != "" %}
            <p class="kicker"><span class="led led--blink" aria-hidden="true"></span>{{ profile.status }}</p>
            {% else %}
            <p class="kicker"><span class="led led--blink" aria-hidden="true"></span>Pixel lab &middot; open to collaborations</p>
            {% endif %}

            <h1 class="hero__name">{{ profile.primary_name }}<span class="hero__dot">.</span></h1>
            {% if profile.secondary_name and profile.secondary_name != "" %}
            <p class="hero__role">{{ profile.secondary_name }}</p>
            {% endif %}

            <ul class="hero__badges">
                {% for position in profile.positions %}
                <li class="hero__badge">
                    {% if position.logo %}<img class="px-img" src="{{ position.logo }}" alt="" loading="lazy" width="22" height="22">{% endif %}
                    {{ position.name }}
                </li>
                {% endfor %}
            </ul>

            <div class="hero__bio prose prose--tight">
                {{ profile.short_bio }}
            </div>

            <div class="hero__actions">
                {% for item in social %}
                {% assign value = profile[item.key] %}
                {% if value and value != "" %}
                {% if item.encode %}
                {% capture href %}mailto:{{ value | encodeEmail }}{% endcapture %}
                {% else %}
                {% assign value_head = value | slice: 0, 4 %}
                {% if value_head == "http" %}
                {% assign href = value %}
                {% else %}
                {% assign href = item.url | replace: "{value}", value %}
                {% endif %}
                {% endif %}
                {% case item.key %}
                {% when "email" %}{% assign iconName = "mail" %}
                {% when "gscholar" %}{% assign iconName = "book" %}
                {% when "github" %}{% assign iconName = "github" %}
                {% when "orcid" %}{% assign iconName = "link" %}
                {% when "blog" %}{% assign iconName = "globe" %}
                {% when "linkedin" %}{% assign iconName = "linkedin" %}
                {% when "twitter" %}{% assign iconName = "x" %}
                {% else %}{% assign iconName = "link" %}
                {% endcase %}
                <a class="btn btn--sm{% if item.primary %} btn--accent{% endif %}" href="{{ href }}"{% unless item.encode %} target="_blank" rel="noopener"{% endunless %}>
                    <svg class="ico" aria-hidden="true"><use href="#i-{{ iconName }}"></use></svg>{{ item.label }}
                </a>
                {% endif %}
                {% endfor %}
            </div>
        </div>

        <aside class="hero__side" aria-label="Profile">
            {% if profile.portrait_url %}
            <figure class="portrait" id="portrait-card">
                <div class="portrait__cam">
                    <div class="portrait__bar" aria-hidden="true">
                        <span class="led led--coral led--blink"></span>
                        <span>cam_01</span>
                        <span>96&times;96</span>
                        <span class="portrait__rec">rec</span>
                    </div>
                    <div class="portrait__screen screen">
                        <img class="portrait__pixel" src="/assets/pixel/portrait-96.png" alt="{{ profile.portrait_alt | default: profile.primary_name }} — pixel-art portrait" width="288" height="288">
                        <img class="portrait__photo" src="{{ profile.portrait_url }}" alt="{{ profile.portrait_alt | default: profile.primary_name }}" width="288" height="288">
                        <span class="screen__glare" aria-hidden="true"></span>
                        <span class="portrait__badge">subj. 01</span>
                    </div>
                </div>
                <div class="portrait__cap">
                    <p>{{ profile.portrait_caption | default: "Pixel study, 16 colours." }}</p>
                    <button class="portrait__toggle" type="button" data-portrait-toggle aria-pressed="false">view photo</button>
                </div>
            </figure>
            {% endif %}

            {% assign project_total = 0 %}
            {% for group in projects.groups %}{% assign project_total = project_total | plus: group.items.size %}{% endfor %}
            {% assign funding_k = team.total_funding | divided_by: 1000 %}
            <dl class="hud">
                <div class="hud__cell">
                    <dt class="hud__k">Papers</dt>
                    <dd class="hud__v">{{ collections.publications.size }}</dd>
                </div>
                <div class="hud__cell">
                    <dt class="hud__k">Projects</dt>
                    <dd class="hud__v">{{ project_total }}</dd>
                </div>
                <div class="hud__cell">
                    <dt class="hud__k">Team</dt>
                    <dd class="hud__v">{{ team.member_count }}<small>+</small></dd>
                </div>
                <div class="hud__cell">
                    <dt class="hud__k">Funding</dt>
                    <dd class="hud__v"><small>&yen;</small>{{ funding_k }}<small>K</small></dd>
                </div>
            </dl>
        </aside>
    </div>
</section>
