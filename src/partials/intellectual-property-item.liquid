<article class="ip-item">
    <div class="ip-mark" aria-hidden="true">
        <i class="fas fa-file-code"></i>
    </div>

    <div class="ip-body">
        <div class="ip-labels">
            <span class="ip-type">{{ item.type }}</span>
            <span class="ip-role"><i class="fas fa-user-pen" aria-hidden="true"></i> {{ item.role }}</span>
        </div>

        <h3 class="ip-title">{{ item.title }}</h3>

        <p class="ip-registration">
            <span class="ip-registration-label">Registration No.</span>
            <span class="ip-registration-number">{{ item.registration_number }}</span>
        </p>
    </div>
</article>
