<article class="project-item ip-item">
    <div class="project-body">
        <div class="project-head">
            <h3 class="project-title ip-title">{{ item.title }}</h3>
            <span class="role-tag ip-role"><i class="fas fa-user-pen" aria-hidden="true"></i> {{ item.role }}</span>
        </div>

        <div class="project-funding ip-meta">
            <span class="tag tag-accent"><i class="fas fa-file-code" aria-hidden="true"></i> {{ item.type }}</span>
            <span class="tag ip-registration"><i class="fas fa-certificate" aria-hidden="true"></i> Registration No. {{ item.registration_number }}</span>
        </div>
    </div>
</article>
