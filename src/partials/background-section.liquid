<section class="sec" id="background">
    <header class="sec-head">
        <span class="sec-head__no" aria-hidden="true">03</span>
        <h2 class="sec-head__title">Save slots<span class="sec-head__dot">.</span></h2>
        <span class="sec-head__rule" aria-hidden="true"></span>
    </header>

    <div class="bg-grid">
        {% if profile.education %}
        <div class="bg-col">
            <h3 class="bg-col__head"><svg class="ico" aria-hidden="true"><use href="#i-book"></use></svg>Education</h3>
            <ol class="track">
                {% for item in profile.education %}
                <li class="track__item">
                    <span class="track__node">
                        {% if item.logo %}<img class="px-img" src="{{ item.logo }}" alt="" loading="lazy">{% else %}<svg class="ico" aria-hidden="true"><use href="#i-book"></use></svg>{% endif %}
                    </span>
                    <div class="track__body">
                        <span class="track__when">{{ item.date }}</span>
                        <span class="track__where">{{ item.name }}</span>
                        <span class="track__what">{{ item.position }}</span>
                    </div>
                </li>
                {% endfor %}
            </ol>
        </div>
        {% endif %}

        {% if profile.experience %}
        <div class="bg-col">
            <h3 class="bg-col__head"><svg class="ico" aria-hidden="true"><use href="#i-briefcase"></use></svg>Experience</h3>
            <ol class="track">
                {% for item in profile.experience %}
                <li class="track__item">
                    <span class="track__node">
                        {% if item.logo %}<img class="px-img" src="{{ item.logo }}" alt="" loading="lazy">{% else %}<svg class="ico" aria-hidden="true"><use href="#i-briefcase"></use></svg>{% endif %}
                    </span>
                    <div class="track__body">
                        <span class="track__when">{{ item.date }}</span>
                        <span class="track__where">{{ item.name }}</span>
                        <span class="track__what">{{ item.position }}</span>
                    </div>
                </li>
                {% endfor %}
            </ol>
        </div>
        {% endif %}
    </div>

    {% if profile.awards %}
    <div class="awards">
        <h3 class="bg-col__head"><svg class="ico" aria-hidden="true"><use href="#i-trophy"></use></svg>Honors &amp; awards</h3>
        <div class="award-grid">
            {% for item in profile.awards %}
            <div class="award">
                <span class="award__medal"><svg class="ico" aria-hidden="true"><use href="#i-trophy"></use></svg></span>
                <div>
                    <div class="award__name">{{ item.name }}</div>
                    <div class="award__year">{{ item.date }}</div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</section>
