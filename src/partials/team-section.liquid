{% assign funding_rmb = team.total_funding | default: 0 %}
{% assign funding_k = funding_rmb | divided_by: 1000 %}
{% assign funding_usd_k = funding_rmb | divided_by: team.cny_per_usd | divided_by: 1000 %}
{%- assign project_count = 0 -%}
{%- for group in projects.groups -%}
{%- assign project_count = project_count | plus: group.items.size -%}
{%- endfor -%}

<section class="sec" id="team">
    <header class="sec-head">
        <span class="sec-head__no" aria-hidden="true">04</span>
        <h2 class="sec-head__title">The team<span class="sec-head__dot">.</span></h2>
        <span class="sec-head__rule" aria-hidden="true"></span>
        <div class="sec-head__aside">
            <a class="chip" href="/collaborators/">Collaborators<svg class="ico" aria-hidden="true"><use href="#i-arrow-right"></use></svg></a>
        </div>
    </header>

    <div class="team">
        <div class="team__text">
            <p>{{ team.description }}</p>
        </div>

        <div class="team__stats">
            <div class="xp">
                <div class="xp__top">
                    <span class="xp__k">Team members</span>
                    <span class="xp__v">{{ team.member_count }}<small>+</small></span>
                </div>
                <div class="meter" aria-hidden="true">
                    {% for i in (1..12) %}<span class="meter__cell{% if i <= team.member_count %} is-on{% endif %}"></span>{% endfor %}
                </div>
            </div>

            <div class="xp">
                <div class="xp__top">
                    <span class="xp__k">Projects run</span>
                    <span class="xp__v">{{ project_count }}</span>
                </div>
                <div class="meter" aria-hidden="true">
                    {% for i in (1..12) %}<span class="meter__cell is-on"></span>{% endfor %}
                </div>
            </div>

            <div class="xp">
                <div class="xp__top">
                    <span class="xp__k">Total funding</span>
                    <span class="xp__v"><small>&yen;</small>{{ funding_k }}K<small>&nbsp;&asymp; &#36;{{ funding_usd_k | toFixed: 1 }}K</small></span>
                </div>
                <div class="meter" aria-hidden="true">
                    {% for i in (1..12) %}<span class="meter__cell{% if i <= 10 %} is-on{% endif %}"></span>{% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>
