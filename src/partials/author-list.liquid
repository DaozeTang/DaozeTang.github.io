{%- comment -%}
    Publication author list. Front matter wraps the site owner in <b>, and
    appends "*" for equal contribution and "#" for the corresponding author.
    Both suffixes are stripped before comparing against profile.primary_name.
{%- endcomment -%}

{%- assign has_eq_contrib = false -%}
{%- assign has_corresponding = false -%}

{%- for _key in authors -%}
    {%- assign plain = _key | strip_html -%}
    {%- assign last_char = plain | slice: -1, 1 -%}
    {%- assign last_2chars = plain | slice: -2, 2 -%}

    {%- if last_2chars == "*#" or last_2chars == "#*" -%}
        {%- assign name = plain | replace: "#*", "" | replace: "*#", "" -%}
        {%- assign mark = "*<sup>#</sup>" -%}
        {%- assign has_eq_contrib = true -%}
        {%- assign has_corresponding = true -%}
    {%- elsif last_char == "*" -%}
        {%- assign name = plain | split: "*" | first -%}
        {%- assign mark = "*" -%}
        {%- assign has_eq_contrib = true -%}
    {%- elsif last_char == "#" -%}
        {%- assign name = plain | split: "#" | first -%}
        {%- assign mark = "<sup>#</sup>" -%}
        {%- assign has_corresponding = true -%}
    {%- else -%}
        {%- assign name = plain -%}
        {%- assign mark = "" -%}
    {%- endif -%}

    {%- assign display_name = name | append: mark -%}
    <span class="author{% if name == profile.primary_name %} me{% endif %}">{{ display_name }}{%- if forloop.index < authors.size -%}, {% endif -%}</span>
{%- endfor -%}

{%- if has_eq_contrib or has_corresponding %}
<mark>(
    {%- if has_eq_contrib -%}
        * <i>equal contribution</i>
    {%- endif -%}
    {%- if has_corresponding -%}
        {%- if has_eq_contrib -%}, {% endif -%}
        <sup>#</sup> <i>corresponding author</i>
    {%- endif -%}
)</mark>
{%- endif -%}
