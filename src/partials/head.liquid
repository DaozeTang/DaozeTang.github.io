<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% assign pageDescription = metaDescription | default: profile.short_bio %}
{%- assign pageUrl = page.url | encodeUri | prepend: site.url -%}
{%- assign ogImage = profile.portrait_url | default: "/favicon.png" -%}
{%- unless ogImage contains "://" -%}{%- assign ogImage = ogImage | prepend: site.url -%}{%- endunless -%}
<meta name="description" content="{{ pageDescription | strip_html | strip_newlines | truncatewords: 30 }}">
<meta name="author" content="{{ profile.primary_name }}">
<title>{{ title }} - {{ profile.navbar_name }}</title>
<link rel="icon" type="image/png" href="/favicon.png">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ pageUrl }}">
<link rel="sitemap" href="/sitemap.xml">

<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title }} - {{ profile.navbar_name }}">
<meta property="og:description" content="{{ pageDescription | strip_html | strip_newlines | truncatewords: 30 }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ ogImage }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }} - {{ profile.navbar_name }}">
<meta name="twitter:description" content="{{ pageDescription | strip_html | strip_newlines | truncatewords: 30 }}">
<meta name="twitter:image" content="{{ ogImage }}">
<meta name="theme-color" id="meta-theme-color" content="#e9e1c9">

<script>
    (function () {
        var mode = "system";
        try {
            var match = document.cookie.match(/(?:^|;\s*)dzt_theme=(light|dark|system)(?:;|$)/);
            var stored = match ? match[1] : localStorage.getItem("theme");
            if (stored === "light" || stored === "dark" || stored === "system") mode = stored;
        } catch (e) {}
        var theme = mode === "system"
            ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
            : mode;
        var root = document.documentElement;
        if (new URLSearchParams(window.location.search).has("capture")) root.setAttribute("data-capture", "true");
        root.setAttribute("data-theme", theme);
        root.setAttribute("data-theme-mode", mode);
        var meta = document.getElementById("meta-theme-color");
        if (meta) meta.setAttribute("content", theme === "dark" ? "#14162b" : "#e9e1c9");
    })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet">

{% unless headMinimal %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/academicons/1.9.1/css/academicons.min.css" integrity="sha512-b1ASx0WHgVFL5ZQhTgiPWX+68KjS38Jk87jg7pe+qC7q9YkEtFq0z7xCglv7qGIs/68d3mAp+StfC8WKC5SSAg==" crossorigin="anonymous" />
{% endunless %}

<link rel="stylesheet" href="/styles/site.css">
