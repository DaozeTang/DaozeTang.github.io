<footer class="site-footer" id="site-footer">
    <div class="shell">
        <div class="footer-base">
            <div class="footer-note">{{ display.footer_text }}</div>
            <div class="footer-meta">
                <span class="footer-meta-item">&copy; 2022&ndash;{{ "now" | date: "%Y" }} {{ profile.primary_name }}</span>
                <span class="footer-meta-group">
                    <span class="sep" aria-hidden="true">&#10038;</span>
                    <span class="footer-meta-item">Updated {{ "now" | date: "%b %Y" }}</span>
                </span>
            </div>
        </div>
    </div>
</footer>
