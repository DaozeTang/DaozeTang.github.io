<article class="cart px-hover">
    <span class="card-fx" aria-hidden="true"></span>
    <div class="cart__tab">
        {% if pubNo %}<span class="cart__no" aria-hidden="true">P.{% if pubNo < 10 %}0{% endif %}{{ pubNo }}</span>{% endif %}
        <span class="cart__venue">{{ item.data.venue }}</span>
        {% if item.data.highlight %}<span class="cart__mark">{{ item.data.highlight }}</span>{% endif %}
        <span class="cart__date">{{ item.date | date: "%Y" }}</span>
    </div>

    <div class="cart__grid">
        <div class="cart__aside">
            {% if item.data.cover %}
            <div class="cart__screen">
                <img src="{{ item.data.cover }}" alt="Figure from {{ item.data.title }}" loading="lazy" decoding="async">
                <span class="cart__fig" aria-hidden="true">FIG.{% if pubNo %}{% if pubNo < 10 %}0{% endif %}{{ pubNo }}{% else %}01{% endif %}</span>
            </div>
            {% else %}
            <div class="cart__placeholder"><svg class="ico" aria-hidden="true"><use href="#i-book"></use></svg></div>
            {% endif %}

            <dl class="cart__spec">
                <div><dt>Authors</dt><dd>{{ item.data.authors.size }}</dd></div>
                {% if item.data.links %}
                <div><dt>Links</dt><dd>{{ item.data.links.size }}</dd></div>
                {% endif %}
                {% if item.data.semantic_scholar_id %}
                {% assign cite = citations[item.data.semantic_scholar_id] %}
                {% if cite.count > 0 %}
                <div><dt>Citations</dt><dd><span class="cite-badge">{{ cite.count }}</span></dd></div>
                {% endif %}
                {% endif %}
            </dl>
        </div>

        <div class="cart__body">
            <h3 class="cart__title">{{ item.data.title }}</h3>

            <p class="cart__authors">
                {% assign authors = item.data.authors %}
                {% include "author-list" %}
            </p>

            {% if item.data.abstract %}
            <p class="cart__abstract">{{ item.data.abstract }}</p>
            {% endif %}

            {% if item.data.links %}
            <div class="cart__links">
                {% for link in item.data.links %}
                <a class="btn btn--sm" href="{{ link[1] }}" target="_blank" rel="noopener">{{ link[0] }}<svg class="ico" aria-hidden="true"><use href="#i-external"></use></svg></a>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</article>