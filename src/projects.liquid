---
layout: base.liquid
title: Projects
navTitle: Projects
permalink: /projects/
subtitle: >-
  Research and student innovation projects I've led, contributed to, or advised —
  organized by year, with the funding behind each where applicable.
---

{% assign totalProjects = 0 %}
{% for group in projects.groups %}
{% assign totalProjects = totalProjects | plus: group.items.size %}
{% endfor %}

<header class="page-head">
    <p class="kicker"><span class="led led--gold" aria-hidden="true"></span>Projects &middot; built with students</p>
    <h1 class="page-head__title">Projects<span style="color: var(--accent)">.</span></h1>
    <p class="page-head__sub">{{ subtitle }}</p>
    <ul class="page-head__meta">
        <li><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-package"></use></svg>{{ totalProjects }} projects</span></li>
        {% for group in projects.groups %}
        <li><a class="chip" href="#year-{{ group.year }}">{{ group.year }} &middot; {{ group.items.size }}</a></li>
        {% endfor %}
    </ul>
</header>

<div class="split">
    <div>
        <div class="year-stack" style="margin-top: 0">
            {% for group in projects.groups %}
            <section class="year-block" id="year-{{ group.year }}">
                <div class="year-block__head">
                    <h2 class="year-block__year">{{ group.year }}</h2>
                    <span class="year-block__count">{{ group.items.size }} project{% if group.items.size > 1 %}s{% endif %}</span>
                    <span class="year-block__rule" aria-hidden="true"></span>
                </div>

                {% for item in group.items %}
                <article class="proj">
                    <span class="proj__role proj__role--{{ item.role | downcase | replace: ' ', '-' }}">{{ item.role }}</span>
                    <div>
                        <h3 class="proj__title">{{ item.title }}</h3>
                        {% if item.funding and item.funding.size > 0 %}
                        <div class="proj__meta">
                            {% for fund in item.funding %}
                            <span class="chip chip--gold"><svg class="ico" aria-hidden="true"><use href="#i-zap"></use></svg>{{ fund }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </article>
                {% endfor %}
            </section>
            {% endfor %}
        </div>
    </div>

    <aside class="rail" aria-label="Jump to year">
        <div>
            <p class="rail__label">Timeline</p>
            <nav class="rail__list" id="year-rail">
                {% for group in projects.groups %}
                <a class="rail__link" href="#year-{{ group.year }}">
                    <span>{{ group.year }}</span>
                    <span class="rail__count">{{ group.items.size }}</span>
                </a>
                {% endfor %}
            </nav>
        </div>
        <div class="panel rail__panel">
            <p class="rail__label">Roles</p>
            <div class="stack stack--tight">
                <span class="chip chip--accent">Advisor</span>
                <span class="chip chip--blue">Leader</span>
                <span class="chip">Member</span>
            </div>
        </div>
    </aside>
</div>
