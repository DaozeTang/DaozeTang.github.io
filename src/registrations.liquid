---
layout: base.liquid
title: Registrations
navTitle: Registrations
permalink: /registrations/
subtitle: >-
  Registered software copyrights and patents arising from my research and
  development work.
---

{% assign totalItems = 0 %}
{% for group in registrations.groups %}
    {% assign totalItems = totalItems | plus: group.items.size %}
{% endfor %}

<header class="page-header">
    <h1 class="page-header-title">Registrations<span class="title-dot">.</span></h1>
    <p class="page-header-subtitle">{{ subtitle }}</p>
    <div class="page-header-meta">
        <span class="page-header-stat"><i class="fas fa-certificate" aria-hidden="true"></i> {{ totalItems }} registrations</span>
        {% for group in registrations.groups %}
        <span class="page-header-stat">{{ group.year }} &middot; {{ group.items.size }}</span>
        {% endfor %}
    </div>
</header>

<div class="pubs-layout reg-layout">
    <div class="pubs-stream">
        {% for group in registrations.groups %}
        <section id="year-{{ group.year }}" class="year-section" data-year="{{ group.year }}">
            <span class="year-ghost" aria-hidden="true">{{ group.year }}</span>
            <header class="year-head">
                <h2 class="year-num">{{ group.year }}</h2>
                <span class="year-count"><b>{{ group.items.size }}</b> registration{% if group.items.size > 1 %}s{% endif %}</span>
                <span class="year-rule" aria-hidden="true"></span>
            </header>

            <div class="reg-list">
                {% for item in group.items %}
                    {% include "registration-item" %}
                {% endfor %}
            </div>
        </section>
        {% endfor %}
    </div>

    <aside class="pubs-rail reg-timeline" aria-label="Jump to year">
        <div class="rail-label">Timeline</div>
        <nav class="rail-nav" id="year-rail">
            {% for group in registrations.groups %}
            <a class="rail-link" href="#year-{{ group.year }}">
                {{ group.year }}
                <span class="rail-count">{{ group.items.size }}</span>
            </a>
            {% endfor %}
        </nav>
    </aside>
</div>
