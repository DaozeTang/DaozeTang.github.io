---
layout: base.liquid
title: Registrations
navTitle: Registrations
permalink: /registrations/
subtitle: >-
  Registered software copyrights and patents arising from my research and
  development work.
---

{% assign totalItems = 0 %}
{% for group in registrations.groups %}
{% assign totalItems = totalItems | plus: group.items.size %}
{% endfor %}

<header class="page-head">
    <p class="kicker"><span class="led led--coral" aria-hidden="true"></span>Registered works &middot; software copyrights</p>
    <h1 class="page-head__title">Registrations<span style="color: var(--accent)">.</span></h1>
    <p class="page-head__sub">{{ subtitle }}</p>
    <ul class="page-head__meta">
        <li><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-shield"></use></svg>{{ totalItems }} registrations</span></li>
        {% for group in registrations.groups %}
        <li><a class="chip" href="#year-{{ group.year }}">{{ group.year }} &middot; {{ group.items.size }}</a></li>
        {% endfor %}
    </ul>
</header>

<div class="split">
    <div>
        <div class="year-stack" style="margin-top: 0">
            {% for group in registrations.groups %}
            <section class="year-block" id="year-{{ group.year }}">
                <div class="year-block__head">
                    <h2 class="year-block__year">{{ group.year }}</h2>
                    <span class="year-block__count">{{ group.items.size }} registration{% if group.items.size > 1 %}s{% endif %}</span>
                    <span class="year-block__rule" aria-hidden="true"></span>
                </div>

                {% for item in group.items %}
                <article class="reg">
                    <h3 class="reg__title">{{ item.title }}</h3>
                    <div class="reg__meta">
                        <span class="chip chip--accent"><svg class="ico" aria-hidden="true"><use href="#i-file"></use></svg>{{ item.type }}</span>
                        <span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-shield"></use></svg>No. {{ item.registration_number }}</span>
                        <span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-pen"></use></svg>{{ item.role }}</span>
                    </div>
                </article>
                {% endfor %}
            </section>
            {% endfor %}
        </div>
    </div>

    <aside class="rail" aria-label="Jump to year">
        <div>
            <p class="rail__label">Timeline</p>
            <nav class="rail__list" id="year-rail">
                {% for group in registrations.groups %}
                <a class="rail__link" href="#year-{{ group.year }}">
                    <span>{{ group.year }}</span>
                    <span class="rail__count">{{ group.items.size }}</span>
                </a>
                {% endfor %}
            </nav>
        </div>
    </aside>
</div>
